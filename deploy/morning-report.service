[Unit]
Description=Garmin morning report to Telegram

[Service]
# make pi-setup fills in @REPO@ and @UV@
Type=oneshot
WorkingDirectory=@REPO@
Environment=TZ=Africa/Johannesburg
# Skip the dev group (notebooks, polars etc.) on the Pi
Environment=UV_NO_DEV=1
# Pick up code changes; a failed pull (e.g. no network yet) doesn't stop the run
ExecStartPre=-/usr/bin/git pull --ff-only
ExecStartPre=@UV@ sync --frozen
ExecStartPre=@UV@ run --frozen playwright install chromium
ExecStart=@UV@ run --frozen message --wait-until 09:00
TimeoutStartSec=4h
