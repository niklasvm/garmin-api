[Unit]
Description=Garmin morning report to Telegram

[Service]
Type=oneshot
WorkingDirectory=%h/garmin-api
Environment=TZ=Africa/Johannesburg
# Pick up code changes; a failed pull (e.g. no network yet) doesn't stop the run
ExecStartPre=-/usr/bin/git pull --ff-only
ExecStartPre=%h/.local/bin/uv sync --frozen
ExecStartPre=%h/.local/bin/uv run --frozen playwright install chromium
ExecStart=%h/.local/bin/uv run --frozen message --wait-until 09:00
TimeoutStartSec=4h
